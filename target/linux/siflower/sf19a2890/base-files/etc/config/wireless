config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/11000000.wifi-lb'
	option band '2g'
	option channel '6'
	option htmode 'HT20'
	option country 'US'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'GL-SFT1200'
	option encryption 'psk2'
	option key 'goodlife'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/17800000.wifi-hb'
	option band '5g'
	option channel '36'
	option htmode 'VHT80'
	option country 'US'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'GL-SFT1200-5G'
	option encryption 'psk2'
	option key 'goodlife'
