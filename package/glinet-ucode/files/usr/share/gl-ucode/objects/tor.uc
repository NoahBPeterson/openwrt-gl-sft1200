// gl-ucode object: tor  (port of decompiled-spec/rpc/tor.lua)
// Tor transparent-proxy gateway over the mainline `tor` package (uci `tor`).
// Firewall: keep the fw4/nftables path only (LAN DNS -> 9053 via a uci DNAT
// rule, LAN TCP -> 9040 via an nft include /etc/firewall.tor.nft). The legacy
// iptables branch is DROPPED (fw4 is always present on mainline 25.12).
// DEGRADE / DROP versus the GL original:
//   - GL gl_ddns.ddns.http_port/https_port reads -> uhttpd-derived ports
//     (uhttpd.main.listen_http / listen_https), since on mainline uhttpd is the
//     web server (no separate GL nginx on 80/443).
//   - kmwan per-member online check in get_status -> ubus network.interface.wan
//     status (kmwan uci/helper absent on mainline).
//   - mptun (astrowarp) conflict guard DROPPED (mptun uci absent).
//   - ovpnclient tap-s2s conflict guard DROPPED (GL ovpnclient tap-s2s absent).
//   - GL /usr/bin/clean_client_conntrack -> conntrack -F fallback when absent.
//   - If /etc/init.d/tor is absent (tor pkg not installed), get_status returns
//     disabled/0 gracefully and the init.d calls in set_config no-op.
'use strict';

const fs = require('fs');

// netmask (dotted quad) -> CIDR prefix length. Defaults to /24 when absent.
function nm2prefix(mask) {
	if (!mask) return 24;
	let bits = 0;
	for (let oct in split(mask, ".")) {
		let n = int(oct);
		while (n) { bits += (n & 1); n = n >> 1; }
	}
	return bits;
}

// Extract the numeric port from a uhttpd listen string ("0.0.0.0:80",
// "[::]:80"). The option may be a uci list -> take the first element.
function uhttpd_port(c, opt, def) {
	let v = c.get("uhttpd", "main", opt);
	if (type(v) == "array") v = v[0];
	if (type(v) != "string") return def;
	let m = match(v, /:([0-9]+)/);
	return m ? m[1] : def;
}

// Redirect-with-ACCEPT exemption (local services keep working through the LAN).
function fw_allow(c, id, label, src_ip, lan_ip, dport) {
	c.delete("firewall", id);
	c.set("firewall", id, "redirect");
	c.set("firewall", id, "name", label);
	c.set("firewall", id, "src", "lan");
	c.set("firewall", id, "src_ip", src_ip);
	c.set("firewall", id, "src_dip", lan_ip);
	c.set("firewall", id, "src_dport", dport);
	c.set("firewall", id, "family", "ipv4");
	c.set("firewall", id, "proto", "tcp");
	c.set("firewall", id, "target", "ACCEPT");
}

// Simple src=lan ACCEPT rule.
function fw_rule(c, id, label, proto, dport, family) {
	c.delete("firewall", id);
	c.set("firewall", id, "rule");
	c.set("firewall", id, "name", label);
	c.set("firewall", id, "src", "lan");
	c.set("firewall", id, "proto", proto);
	c.set("firewall", id, "dest_port", dport);
	c.set("firewall", id, "family", family);
	c.set("firewall", id, "target", "ACCEPT");
}

// Write the nft include that redirects new LAN TCP connections to tor's
// TransPort (9040), skipping the locally-served / tor ports so local access
// and tor's own listeners are not hijacked.
function write_tor_nft(ports) {
	let seen = {};
	let list = [];
	for (let p in ports) {
		let n = int(p);
		if (n > 0 && !seen[n]) { seen[n] = true; push(list, n); }
	}
	let set = join(", ", list);
	let nft =
		"# Auto-generated by gl-ucode tor object. LAN TCP -> tor TransPort 9040.\n" +
		"chain tor_prerouting {\n" +
		"\ttype nat hook prerouting priority 101; policy accept;\n" +
		`\tiifname "br-lan" meta nfproto ipv4 tcp flags syn tcp dport != { ${set} } redirect to :9040\n` +
		"}\n";
	fs.writefile("/etc/firewall.tor.nft", nft);
}

// Sync torrc TransPort/DNSPort bind IP to the current LAN ip. Returns 1 if it
// rewrote the file (so the caller knows tor must restart), 0 otherwise.
function replace_ip(c, ctx) {
	if (!fs.access("/etc/tor/torrc")) return 0;
	let org = ctx.popen("grep TransPort /etc/tor/torrc | awk -F '[ :]' '{print $2}' | head -n1");
	org = org ? trim(org) : "";
	if (org != "") {
		let new_ip = c.get("network", "lan", "ipaddr");
		if (new_ip && org != new_ip) {
			ctx.popen(`sed -i -e "s/${org}/${new_ip}/g" /etc/tor/torrc`);
			return 1;
		}
	}
	return 0;
}

// Apply the manual ExitNodes/StrictNodes selection into torrc.
function replace_country(c, ctx) {
	if (!fs.access("/etc/tor/torrc")) return;
	let country = c.get("tor", "global", "countries") ?? "";
	let manual = c.get("tor", "global", "manual") ?? "0";
	if (int(manual) == 0) {
		ctx.popen("sed -i 's/GeoIPFile/#GeoIPFile/' /etc/tor/torrc");
		ctx.popen("sed -i '/StrictNodes/d;/ExitNodes/d' /etc/tor/torrc");
	} else {
		ctx.popen("sed -i 's/.*GeoIPFile/GeoIPFile/' /etc/tor/torrc");
		ctx.popen("sed -i '/StrictNodes/d;/ExitNodes/d' /etc/tor/torrc");
		ctx.popen("echo 'StrictNodes 1' >> /etc/tor/torrc");
		let countries = "{" + replace(country, " ", "},{") + "}";
		ctx.popen(`echo "ExitNodes ${countries}" >> /etc/tor/torrc`);
	}
}

function tor_on(ctx) {
	let c = ctx.uci.cursor();

	// LAN-facing ACCEPT rules so DHCP/DNS/SOCKS/Trans keep flowing.
	fw_rule(c, "tor_dhcp",  "Allow-Tor-DHCP",        "udp", "67",   "ipv4");
	fw_rule(c, "tor_dns",   "Allow-Tor-DNS",         "udp", "9053", "any");
	fw_rule(c, "tor_tras",  "Allow-Tor-Transparent", "tcp", "9040", "ipv4");
	fw_rule(c, "tor_socks", "Allow-Tor-SOCKS",       "tcp", "9050", "ipv4");

	// DEGRADE: gl_ddns http/https ports -> uhttpd listen ports (mainline uhttpd
	// is the web server; there is no separate GL nginx on 80/443).
	let http_port      = uhttpd_port(c, "listen_http",  "80");
	let https_port     = uhttpd_port(c, "listen_https", "443");
	let luci_http_port  = uhttpd_port(c, "listen_http",  "8080");
	let luci_https_port = uhttpd_port(c, "listen_https", "8443");
	let adg_port = "3000";
	let ssh_port = c.get("dropbear", "@dropbear[0]", "Port") ?? "22";

	let lan_ip = c.get("network", "lan", "ipaddr");
	let lan_mask = c.get("network", "lan", "netmask") ?? "255.255.255.0";
	let src_ip = lan_ip ? `${lan_ip}/${nm2prefix(lan_mask)}` : null;

	if (lan_ip && src_ip) {
		fw_allow(c, "tor_allow_http",        "Allow access http",        src_ip, lan_ip, http_port);
		fw_allow(c, "tor_allow_luci_http",   "Allow access luci http",   src_ip, lan_ip, luci_http_port);
		fw_allow(c, "tor_allow_luci_https",  "Allow access luci https",  src_ip, lan_ip, luci_https_port);
		fw_allow(c, "tor_allow_adguardhome", "Allow access adguardhome", src_ip, lan_ip, adg_port);
		fw_allow(c, "tor_allow_https",       "Allow access https",       src_ip, lan_ip, https_port);
		fw_allow(c, "tor_allow_ssh",         "Allow access ssh",         src_ip, lan_ip, ssh_port);
	}

	c.delete("firewall", "tor_allow");
	c.set("firewall", "tor_allow", "redirect");
	c.set("firewall", "tor_allow", "name", "Allow access tor domain");
	c.set("firewall", "tor_allow", "src", "lan");
	c.set("firewall", "tor_allow", "src_dport", "9050");
	c.set("firewall", "tor_allow", "family", "ipv4");
	c.set("firewall", "tor_allow", "proto", "tcp");
	c.set("firewall", "tor_allow", "target", "ACCEPT");

	// DNS interception: LAN udp/53 -> tor DNSPort 9053 (uci DNAT rule).
	c.delete("firewall", "dns_int");
	c.set("firewall", "dns_int", "redirect");
	c.set("firewall", "dns_int", "name", "Intercept-DNS");
	c.set("firewall", "dns_int", "src", "lan");
	c.set("firewall", "dns_int", "src_dport", "53");
	c.set("firewall", "dns_int", "dest_port", "9053");
	c.set("firewall", "dns_int", "family", "any");
	c.set("firewall", "dns_int", "proto", "udp");
	c.set("firewall", "dns_int", "target", "DNAT");

	// TCP interception via nft include (fw4 path only; iptables branch dropped).
	write_tor_nft([ http_port, https_port, luci_http_port, luci_https_port,
	                adg_port, ssh_port, "9040", "9050", "9053" ]);
	c.delete("firewall", "tcp_int");
	c.set("firewall", "tcp_int", "include");
	c.set("firewall", "tcp_int", "type", "nftables");
	c.set("firewall", "tcp_int", "path", "/etc/firewall.tor.nft");
	c.set("firewall", "tcp_int", "position", "table-post");

	c.set("firewall", "@forwarding[0]", "enabled", "0");
	if (c.get("firewall", "guestzone_fwd") != null)
		c.set("firewall", "guestzone_fwd", "enabled", "0");   // GL guest zone, if present

	c.set("tor", "global", "enable", "1");
	c.commit("firewall");
	c.commit("tor");
	ctx.popen("/etc/init.d/firewall reload >/dev/null 2>&1");

	let replace_ip_status = replace_ip(c, ctx);
	let run = ctx.popen("ps | grep /usr/sbin/tor | grep -v grep") ?? "";
	if (run == "" || replace_ip_status == 1) {
		replace_country(c, ctx);
		ctx.popen("sync");
		ctx.popen("/etc/init.d/tor enable >/dev/null 2>&1");
		ctx.popen("/etc/init.d/tor restart >/dev/null 2>&1");
	}
	// DEGRADE: GL clean_client_conntrack absent -> flush conntrack directly.
	ctx.popen("[ -x /usr/bin/clean_client_conntrack ] && /usr/bin/clean_client_conntrack || conntrack -F >/dev/null 2>&1");
}

function tor_exit(ctx) {
	let c = ctx.uci.cursor();
	for (let id in [ "tor_dhcp", "tor_dns", "tor_tras", "tor_socks",
	                 "tor_allow_http", "tor_allow_https", "tor_allow_luci_http",
	                 "tor_allow_luci_https", "tor_allow_adguardhome",
	                 "tor_allow_ssh", "tor_allow", "dns_int", "tcp_int" ])
		c.delete("firewall", id);

	c.set("firewall", "@forwarding[0]", "enabled", "1");
	if (c.get("firewall", "guestzone_fwd") != null)
		c.set("firewall", "guestzone_fwd", "enabled", "1");

	c.set("tor", "global", "enable", "0");
	c.commit("firewall");
	c.commit("tor");

	ctx.popen("/etc/init.d/firewall reload >/dev/null 2>&1");
	ctx.popen("/etc/init.d/tor stop >/dev/null 2>&1");
	ctx.popen("/etc/init.d/tor disable >/dev/null 2>&1");
	// DROP: legacy iptables PREROUTING teardown (fw4-only device).
}

export default {
	get_config: function(args, ctx) {
		let c = ctx.uci.cursor();
		let countries = [];
		let country_info = c.get("tor", "global", "countries") ?? "all";
		if (country_info != "all") {
			for (let w in split(trim(country_info), /\s+/))
				if (w != "") push(countries, w);
		}
		return {
			enable: (c.get("tor", "global", "enable") == "1"),
			countries: countries,
			manual: (c.get("tor", "global", "manual") == "1")
		};
	},

	set_config: function(args, ctx) {
		let c = ctx.uci.cursor();

		// DROP: ovpnclient tap-s2s conflict guard (GL tap-s2s absent on mainline).
		// DROP: mptun/astrowarp conflict guard (mptun uci absent on mainline).

		let enable = args.enable;
		let manual = args.manual ? 1 : 0;
		let countries = args.countries ?? [];

		if (enable != null && type(enable) != "bool")
			return ctx.util.E.INVALID_PARAMS;
		if (args.manual != null && type(args.manual) != "bool")
			return ctx.util.E.INVALID_PARAMS;
		if (args.countries != null && type(args.countries) != "array")
			return ctx.util.E.INVALID_PARAMS;

		if (args.manual != null || args.countries != null) {
			if (manual == 1 && enable == true)
				c.set("tor", "global", "countries", join(" ", countries));
			c.set("tor", "global", "manual", `${manual}`);
		}

		if (enable == true) {
			ctx.popen("echo 3 > /proc/sys/vm/drop_caches");
			c.set("tor", "global", "enable", "1");
			c.commit("tor");
			ctx.popen("/etc/init.d/tor stop >/dev/null 2>&1");
			fs.unlink("/var/lib/tor/control.log");
			tor_on(ctx);
		} else {
			c.set("tor", "global", "enable", "0");
			c.commit("tor");
			tor_exit(ctx);
			fs.unlink("/var/lib/tor/control.log");
			ctx.popen("rm -rf /.tor/");
		}
		return {};
	},

	get_status: function(args, ctx) {
		let c = ctx.uci.cursor();
		let tor_status = {};

		// DEGRADE: tor package not installed -> disabled/0.
		if (!fs.access("/etc/init.d/tor"))
			return { status: 0, log: "" };

		// DEGRADE: kmwan per-member online check -> mainline ubus wan status.
		let wan = ctx.ubus.call("network.interface.wan", "status") ?? {};
		let online = wan.up ? true : false;

		if (!online)
			fs.unlink("/var/lib/tor/control.log");

		let enable = c.get("tor", "global", "enable") == "1";
		if (enable) {
			if (online) {
				let percent = null;
				if (fs.access("/var/lib/tor/control.log")) {
					let out = ctx.popen("grep Bootstrapped /var/lib/tor/control.log | tail -n 1");
					percent = (out && trim(out) != "") ? trim(out) : null;
				}
				if (percent) {
					if (match(percent, /100/)) {
						tor_status.status = 1;
						tor_status.log = "tor connection succeeded";
					} else {
						tor_status.status = 2;
						tor_status.log = percent;
					}
				} else {
					tor_status.status = 0;
					tor_status.log = "Initialization tor configuration";
				}
			} else {
				tor_status.status = 0;
				tor_status.log = "Initialization tor configuration";
			}
		}
		return tor_status;
	}
};
