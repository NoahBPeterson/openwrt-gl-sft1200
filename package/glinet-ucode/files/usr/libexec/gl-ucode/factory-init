#!/usr/bin/ucode
// gl-ucode: factory-identity shim. On mainline there is no /proc/gl-hw-info (that
// procfs tree is produced by GL's out-of-tree gl-sdk4-hw-info.ko, which reads the
// "factory" MTD partition). This reads the same partition directly and materializes
// the GL device identity into a `factory` uci config, which our RPC objects read
// (device_ddns is GoodCloud's root-of-trust; device_mac/country feed cable/system/etc).
// Run once at boot (see uci-defaults). Idempotent.
'use strict';

const fs  = require('fs');
const uci = require('uci');

// Locate the "factory" mtd char device by label (/proc/mtd), fall back to mtd3.
function factory_mtd() {
	let m = fs.readfile('/proc/mtd') ?? '';
	for (let line in split(m, '\n')) {
		let g = match(line, /^(mtd[0-9]+):.*"(factory|art|product)"/);
		if (g) return '/dev/' + g[1];
	}
	return '/dev/mtd3';
}

/**
 * @param {string} dev
 * @param {integer} n
 */
function read_blob(dev, n) {
	let f = fs.open(dev, 'r');
	if (!f) return '';
	let d = f.read(n) ?? '';
	f.close();
	return d;
}

// device MAC from the running system (factory MAC == the lan/eth base).
function device_mac() {
	for (let dev in ['eth0', 'br-lan']) {
		let a = fs.readfile(`/sys/class/net/${dev}/address`);
		if (a) return uc(trim(a));
	}
	return '';
}

let blob = read_blob(factory_mtd(), 4096);

// device_ddns = the first 32-lowercase-hex run (GoodCloud device id), with the 2-letter
// country code immediately after. Byte-scan (NOT regex) because the blob is binary and
// ucode's regex stops at the first NUL. Scan for the offset then read fixed fields.
let ddns = '', country = '';
function is_hex(c) { return (c >= 48 && c <= 57) || (c >= 97 && c <= 102); }
function is_upper(c) { return c >= 65 && c <= 90; }
for (let i = 0; i + 32 <= length(blob); i++) {
	let ok = true;
	for (let j = 0; j < 32; j++) if (!is_hex(ord(blob, i + j))) { ok = false; break; }
	if (!ok) continue;
	// a 32-hex run bounded by a non-hex byte before it (field start)
	if (i > 0 && is_hex(ord(blob, i - 1))) continue;
	ddns = substr(blob, i, 32);
	let a = ord(blob, i + 32), b = ord(blob, i + 33);
	if (is_upper(a) && is_upper(b)) country = chr(a) + chr(b);
	break;
}
let c = uci.cursor();
if (!c)
{
	die("uci.cursor() returned null!");
}

let mac = device_mac();
if (country == '') {
	country = c.get('wireless', 'radio0', 'country') ?? 'US';
	print("c was null!");
}

// ensure the config file exists before the cursor writes to it
if (!fs.access('/etc/config/factory')) { let t = fs.open('/etc/config/factory', 'w'); if (t) t.close(); }

// named section "device" of type "device"
c.set('factory', 'device', 'device');
if (ddns != '')    c.set('factory', 'device', 'ddns', ddns);
if (mac != '')     c.set('factory', 'device', 'mac', mac);
if (country != '') c.set('factory', 'device', 'country', country);
c.set('factory', 'device', 'model', 'sft1200');
c.commit('factory');

printf("factory-init: ddns=%s mac=%s country=%s\n", ddns, mac, country);
