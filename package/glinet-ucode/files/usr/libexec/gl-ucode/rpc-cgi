#!/usr/bin/ucode
// gl-ucode: CGI fallback for POST /rpc (used if the uhttpd ucode-handler is
// unavailable). Map via uhttpd:  list interpreter '.gl=/usr/libexec/gl-ucode/rpc-cgi'
// and place a /www/rpc.gl, or route /cgi-bin to it. Reads stdin, writes stdout.
'use strict';

import { handle } from '../../share/gl-ucode/rpc.uc';

const fs = require('fs');

let len  = int(getenv("CONTENT_LENGTH") ?? "0");
let body = (len > 0) ? (fs.stdin.read(len) ?? "") : (fs.stdin.read("all") ?? "");

let remote = getenv("REMOTE_ADDR") ?? "";
let HTTP_COOKIE = getenv("HTTP_COOKIE");
if (HTTP_COOKIE == null)
	HTTP_COOKIE = '';

let reqinfo = {
	remote_addr: remote,
	is_local: (remote == "127.0.0.1" || remote == "::1"),
	glinet: (getenv("HTTP_GLINET") != null),
	token: (match(getenv("HTTP_COOKIE") ?? "", /Admin-Token=([^;]+)/) ? match(HTTP_COOKIE, /Admin-Token=([^;]+)/)[1] : null)
};

let sink = {};
let resp = handle(body, reqinfo, sink);

print("Status: 200 OK\r\n");
print("Content-Type: application/json\r\n");
print("X-Frame-Options: DENY\r\n");
if (sink.set_cookie)
	print(`Set-Cookie: ${sink.set_cookie}\r\n`);
print("\r\n");
print(sprintf("%J", resp));
