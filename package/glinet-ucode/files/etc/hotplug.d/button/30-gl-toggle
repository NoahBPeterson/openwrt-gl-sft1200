#!/bin/sh
# GL.iNet mode slide-switch -> drive the function bound in the app.
#
# The SFT1200 mode control is a 2-position slide switch on gpio-513 (BTN_0):
#   ACTION=pressed  -> gpio active-low  (one position)  -> function ON
#   ACTION=released -> gpio inactive/hi (other position) -> function OFF
# The binding (func + sub_func) is stored by switch-button.set_config. We enforce
# it by calling our own /rpc methods locally (localhost + HTTP_GLINET bypasses auth),
# matching what the app would do.

[ "$BUTTON" = "BTN_0" ] || exit 0

func=$(uci -q get switch-button.main.func 2>/dev/null || uci -q get switch-button.@main[0].func 2>/dev/null)
[ -n "$func" ] && [ "$func" != "none" ] || exit 0
sub=$(uci -q get switch-button.main.sub_func 2>/dev/null || uci -q get switch-button.@main[0].sub_func 2>/dev/null)

if [ "$ACTION" = "pressed" ]; then on=1; else on=0; fi

# record the switch position so switch-button.check_sync_status/sync can read it
# WITHOUT polling /sys/kernel/debug/gpio (hammering that debugfs crashes the gpio driver).
echo "$on" > /tmp/gl-switch-pos

rpc() { printf '%s' "$1" | REMOTE_ADDR=127.0.0.1 HTTP_GLINET=1 ucode /usr/libexec/gl-ucode/rpc-cgi 2>/dev/null; }
logger -t gl-toggle "mode switch: func=$func sub=$sub on=$on"

case "$func" in
wireguard|vpn)
	if [ "$on" = 1 ]; then
		# start the selected/first saved config (get_status reports its ids even when idle)
		st=$(rpc '{"jsonrpc":"2.0","id":1,"method":"call","params":["x","wg-client","get_status",{}]}')
		gid=$(printf '%s' "$st" | sed -n 's/.*"group_id": *\([0-9][0-9]*\).*/\1/p' | head -1)
		pid=$(printf '%s' "$st" | sed -n 's/.*"peer_id": *\([0-9][0-9]*\).*/\1/p' | head -1)
		[ -n "$gid" ] && [ -n "$pid" ] && \
			rpc "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"call\",\"params\":[\"x\",\"wg-client\",\"start\",{\"group_id\":$gid,\"peer_id\":$pid}]}" >/dev/null
	else
		rpc '{"jsonrpc":"2.0","id":1,"method":"call","params":["x","wg-client","stop",{}]}' >/dev/null
	fi
	;;
openvpn)
	if [ "$on" = 1 ]; then
		rpc '{"jsonrpc":"2.0","id":1,"method":"call","params":["x","ovpn-client","start",{}]}' >/dev/null
	else
		rpc '{"jsonrpc":"2.0","id":1,"method":"call","params":["x","ovpn-client","stop",{}]}' >/dev/null
	fi
	;;
wifi)
	# "go dark": toggle the CLIENT AP(s), never the uplink STA. A bound sub_func (2g/5g)
	# limits it to that band. On ON we skip the radio hosting the STA so we never fight
	# the repeater's band-arrangement (that radio's AP must stay off).
	sta=$(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)\.mode='sta'/\1/p" | head -1)
	sta_radio=$(uci -q get wireless.$sta.device)
	for s in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)\.mode='ap'/\1/p"); do
		dev=$(uci -q get wireless.$s.device)
		band=$(uci -q get wireless.$dev.band)
		[ -n "$sub" ] && [ "$band" != "$sub" ] && continue
		if [ "$on" = 1 ]; then
			[ "$dev" = "$sta_radio" ] && continue   # keep clients off the uplink radio
			uci set wireless.$s.disabled=0
		else
			uci set wireless.$s.disabled=1
		fi
	done
	uci commit wireless
	setsid /sbin/wifi reload </dev/null >/dev/null 2>&1 &
	;;
repeater)
	# off -> disconnect the uplink STA. on -> leave reconnection to the app / saved AP
	# (no safe generic "reconnect last" without the credentials the app holds).
	[ "$on" = 0 ] && rpc '{"jsonrpc":"2.0","id":1,"method":"call","params":["x","repeater","disconnect",{}]}' >/dev/null
	;;
adguardhome)
	# ON: run AdGuardHome (DNS on 127.0.0.1:3053) and route LAN DNS through it.
	if [ "$on" = 1 ]; then
		/etc/init.d/adguardhome enable 2>/dev/null; /etc/init.d/adguardhome start 2>/dev/null
		uci -q del_list dhcp.@dnsmasq[0].server='127.0.0.1#3053'
		uci add_list dhcp.@dnsmasq[0].server='127.0.0.1#3053'
		uci -q set dhcp.@dnsmasq[0].noresolv='1'
		uci commit dhcp; /etc/init.d/dnsmasq restart 2>/dev/null
	else
		uci -q del_list dhcp.@dnsmasq[0].server='127.0.0.1#3053'
		uci -q delete dhcp.@dnsmasq[0].noresolv
		uci commit dhcp; /etc/init.d/dnsmasq restart 2>/dev/null
		/etc/init.d/adguardhome stop 2>/dev/null; /etc/init.d/adguardhome disable 2>/dev/null
	fi
	;;
tor)
	# ON: run Tor and transparently route LAN TCP + DNS through it (TransPort 9040,
	# DNSPort 9053). Slow but anonymous. OFF: drop the redirect and stop Tor.
	if [ "$on" = 1 ]; then
		# ensure Tor exposes the transparent + dns ports
		grep -q '^TransPort 9040' /etc/tor/torrc 2>/dev/null || cat >> /etc/tor/torrc <<'TORRC'
TransPort 9040
DNSPort 9053
TORRC
		/etc/init.d/tor enable 2>/dev/null; /etc/init.d/tor restart 2>/dev/null
		sleep 3
		nft -f - 2>/dev/null <<'NFT'
table inet gl_tor {
	chain pre {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "br-lan" udp dport 53 redirect to :9053
		iifname "br-lan" tcp dport 53 redirect to :9053
		iifname "br-lan" meta l4proto tcp redirect to :9040
	}
}
NFT
	else
		nft delete table inet gl_tor 2>/dev/null
		/etc/init.d/tor stop 2>/dev/null; /etc/init.d/tor disable 2>/dev/null
	fi
	;;
esac
exit 0
